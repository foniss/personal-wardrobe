# ==================================================================
# Copy to .env and adjust. No secrets are required for the default
# (fully local) setup.
# ==================================================================

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db


# ==================================================================
# VIRTUAL TRY-ON
#
# The website works completely without any of this. The wardrobe,
# image processing, colour extraction, outfit matcher and saved
# outfits never touch these settings. Only the photorealistic
# try-on image needs a provider.
#
# Default provider is LOCAL CatVTON — no API key, no cloud, images
# never leave your machine.
# ==================================================================

# Master switch for the local provider. Set to false to turn the
# local integration off entirely.
VTON_ENABLED=true

# Which adapter to use: catvton (local) | fal | gemini
# If unset, the first available provider wins (local is tried first).
VTON_PROVIDER=catvton
TRYON_PROVIDER=catvton

# Where the local Python service listens.
# Must match the --host/--port you start vton-service/server.py with.
VTON_SERVICE_URL=http://127.0.0.1:8188

# How long Next.js waits for a local generation before giving up.
# GPU: ~10-60s is typical. CPU: many minutes — raise this if you
# enable CATVTON_ALLOW_CPU.
VTON_TIMEOUT_MS=600000


# ------------------------------------------------------------------
# Local CatVTON service settings
#
# These are read by vton-service/server.py (the Python side), not by
# Next.js. Put them in your shell environment, or in this .env if you
# start the service through a tool that loads it.
# ------------------------------------------------------------------

# Path to your CatVTON checkout (git clone https://github.com/Zheng-Chong/CatVTON)
# CATVTON_PATH=C:\dev\CatVTON

# Host/port for the Python service
# VTON_SERVICE_HOST=127.0.0.1
# VTON_SERVICE_PORT=8188

# Weights (downloaded automatically from HuggingFace on first run)
# CATVTON_REPO=zhengchong/CatVTON
# The original runwayml/stable-diffusion-inpainting repo was removed
# from the Hub; this mirror is used by default.
# CATVTON_BASE_MODEL=botp/stable-diffusion-v1-5-inpainting

# Inference settings (these are part of the try-on cache key)
# CATVTON_WIDTH=768
# CATVTON_HEIGHT=1024
# CATVTON_STEPS=50
# CATVTON_GUIDANCE=2.5
# CATVTON_MIXED_PRECISION=bf16

# Force a device instead of auto-detecting: cuda | cpu | mps
# CATVTON_DEVICE=

# CPU inference is possible but extremely slow (many minutes per
# image), so it is OFF by default and must be opted into.
# CATVTON_ALLOW_CPU=false

# Load the model at service startup instead of on first request.
# CATVTON_EAGER_LOAD=false


# ==================================================================
# OPTIONAL cloud providers (not required; local is the default)
#
# Only set these if you deliberately want to send images to a
# third-party API instead of running locally.
# ==================================================================

# fal.ai — https://fal.ai/dashboard/keys
# FAL_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=
