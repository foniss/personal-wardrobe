# ------------------------------------------------------------------
# Node / Next.js
# ------------------------------------------------------------------
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------
# Environment & secrets — never commit real credentials
# ------------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# ------------------------------------------------------------------
# Private user data (reference photos + generated try-on images).
# These live outside the web root and must never be published.
# ------------------------------------------------------------------
.data/

# User-uploaded wardrobe photos. The demo assets in public/seed and
# public/images ARE committed; real uploads are not.
/public/uploads/

# ------------------------------------------------------------------
# Python virtual environments (root & nested)
# ------------------------------------------------------------------
.venv/
.venv*/
venv/
venv*/
vton-service/.venv/
vton-service/venv/
vton-service/__pycache__/
vton-service/**/__pycache__/
vton-service/output/
vton-service/models/
vton-service/checkpoints/
**/*.py[cod]
.python-version

# CatVTON checkout, if placed inside the repo
/CatVTON/

# Model weights, ONNX models & HuggingFace cache (multiple GB — never commit)
*.safetensors
*.ckpt
*.pth
*.pt
*.bin
*.onnx
weights/
**/weights/
.cache/
.huggingface/
hf_cache/

# Local test outputs, debug artifacts & backups
repomix-output.xml
outputs/
**/outputs/
debug_outputs/
test_outputs/
test_outputs_*/
fashn_vton_git_standalone/
.git_backup/
**/.git_backup/

